{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atsas.arena.ai/aif/v0.1/schema/common.schema.json",
  "title": "AIFCommonDefinitions",
  "description": "Shared primitive types, state enums, EvidenceCoverage, and Finding definitions for AIF-0.1.0.",
  "type": "object",
  "$defs": {
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9._-]+$"
    },
    "IsoTimestamp": {
      "type": "string",
      "minLength": 10
    },
    "AuthorityState": {
      "type": "string",
      "enum": ["AUTHORIZED", "NOT_AUTHORIZED", "UNKNOWN", "EXPIRED", "CONFLICTING"]
    },
    "AdmissionState": {
      "type": "string",
      "enum": ["ADMITTED", "INSPECT_ONLY", "BLOCKED", "REJECTED"]
    },
    "ActionType": {
      "type": "string",
      "enum": [
        "READ",
        "LIST",
        "SEARCH",
        "INSPECT",
        "EXECUTE",
        "VERIFY",
        "CREATE",
        "MODIFY",
        "DELETE",
        "RENAME",
        "GENERATE",
        "COMMIT",
        "PUSH",
        "GIT_PUSH",
        "RELEASE"
      ]
    },
    "ExecutionState": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "STARTED",
        "EXECUTED",
        "FAILED",
        "CANCELLED",
        "INTERRUPTED",
        "NOT_OBSERVABLE"
      ]
    },
    "VerificationState": {
      "type": "string",
      "enum": [
        "NOT_VERIFIED",
        "UNVERIFIED",
        "VERIFYING",
        "VERIFIED",
        "PARTIAL",
        "CONTRADICTED",
        "STALE",
        "MISMATCH",
        "BLOCKED",
        "NOT_OBSERVABLE"
      ]
    },
    "ObservationState": {
      "type": "string",
      "enum": [
        "NOT_REQUESTED",
        "NOT_CHECKED",
        "NOT_OBSERVABLE",
        "UNKNOWN",
        "PARTIAL",
        "CONTRADICTED",
        "OBSERVED",
        "DERIVED",
        "CLAIMED"
      ]
    },
    "CompletionState": {
      "type": "string",
      "enum": ["BLOCKED", "INCOMPLETE", "UNVERIFIED", "COMPLETABLE", "COMPLETED"]
    },
    "EvidenceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "claim_id",
        "subject_match",
        "snapshot_match",
        "scope_match",
        "method_match",
        "freshness",
        "adequacy",
        "limitations"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "claim_id": { "type": "string", "minLength": 1 },
        "subject_match": { "type": "boolean" },
        "snapshot_match": { "type": "boolean" },
        "scope_match": { "type": "boolean" },
        "method_match": { "type": "boolean" },
        "freshness": {
          "type": "string",
          "enum": ["FRESH", "STALE", "NON_INTERSECTING_CHANGE", "SNAPSHOT_INDEPENDENT"]
        },
        "adequacy": {
          "type": "string",
          "enum": ["SUFFICIENT", "PARTIAL", "INSUFFICIENT", "CONTRADICTORY", "UNVERIFIABLE"]
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "category",
        "severity",
        "proposition",
        "subject",
        "snapshot",
        "evidence_refs",
        "confidence",
        "limitations",
        "remediation_authorized"
      ],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
        },
        "proposition": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "snapshot": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "string",
          "enum": ["CONFIRMED", "SUSPECTED", "UNKNOWN"]
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "remediation_authorized": { "type": "boolean" }
      }
    }
  }
}
