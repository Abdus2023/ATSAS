{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.ai/schemas/aif/v0.1/authority-event.schema.json",
  "title": "AIF-0.1 AuthorityEvent",
  "description": "Time- and scope-bounded authority event separating authority_basis from supporting evidence[] (AIF-001, AIF-001A, AIF-010).",
  "type": "object",
  "required": [
    "event_id",
    "request_id",
    "actor",
    "authority_basis",
    "authority_status",
    "action_scope",
    "path_scope",
    "restrictions",
    "issued_at",
    "effective_from",
    "expires_at",
    "issuer",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "authority_basis": { "type": "string", "minLength": 1 },
    "authority_status": {
      "enum": [
        "AUTHORIZED",
        "NOT_AUTHORIZED",
        "UNKNOWN",
        "EXPIRED",
        "CONFLICTING"
      ]
    },
    "action_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "path_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "restrictions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "issued_at": { "type": "string", "minLength": 10 },
    "effective_from": { "type": "string", "minLength": 10 },
    "expires_at": { "type": "string", "minLength": 10 },
    "issuer": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
