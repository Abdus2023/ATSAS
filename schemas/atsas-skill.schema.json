{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.ai/schemas/atsas/atsas-skill.schema.json",
  "title": "ATSAS Skill Contract",
  "description": "Declarative procedural skill definition in ATSAS. Explicitly encodes skill portability scope ('Location is not scope') and decouples procedural execution from AIF verification evidence.",
  "type": "object",
  "required": [
    "skill_id",
    "version",
    "scope",
    "domain",
    "description",
    "allowed_tools",
    "steps",
    "verification_requirements",
    "is_evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "ARENA_GENERIC",
        "STREAMFORGE_REPO"
      ],
      "description": "Portability scope of the skill ('Location is not scope')."
    },
    "adaptation": {
      "type": "string",
      "enum": [
        "NONE",
        "STREAMFORGE"
      ],
      "description": "Optional repository adaptation overlay when scope is ARENA_GENERIC."
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "instruction"
        ],
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          }
        }
      }
    },
    "verification_requirements": {
      "type": "array",
      "minItems": 1,
      "description": "Acceptance criteria that must be independently verified through AIF after skill execution.",
      "items": {
        "type": "string"
      }
    },
    "is_evidence": {
      "type": "boolean",
      "const": false,
      "description": "Axiom enforcement: A skill is not evidence."
    }
  }
}
