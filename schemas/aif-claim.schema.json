{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.ai/schemas/aif/aif-claim.schema.json",
  "title": "AIF Epistemic Claim & Verification Record",
  "description": "A scope-bounded, snapshot-bound assertion evaluated under AIF non-binary epistemic states.",
  "type": "object",
  "required": [
    "claim_id",
    "statement",
    "scope",
    "snapshot_id",
    "status",
    "evidence_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^claim-[a-zA-Z0-9_-]+$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Target files, directories, or interfaces asserted by the claim."
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snap-[a-zA-Z0-9_-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "UNKNOWN",
        "NOT_OBSERVABLE",
        "PARTIAL",
        "STALE",
        "MISMATCH",
        "CONTRADICTED"
      ],
      "description": "Explicit non-binary epistemic state of the claim."
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence IDs backing this claim. Must be non-empty if status is VERIFIED."
    },
    "verification_notes": {
      "type": "string"
    }
  }
}
