{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.ai/schemas/aif/aif-evidence.schema.json",
  "title": "AIF Evidence Artifact",
  "description": "Scope-bounded, snapshot-bound, execution-provenanced evidence artifact supporting one or more AIF claims.",
  "type": "object",
  "required": [
    "evidence_id",
    "artifact_kind",
    "snapshot_id",
    "tree_hash",
    "scope",
    "execution_id",
    "observation_id",
    "predicate_satisfied",
    "digest"
  ],
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^evid-[a-zA-Z0-9_-]+$"
    },
    "artifact_kind": {
      "type": "string",
      "enum": [
        "OBSERVATION_VERIFICATION",
        "DIFF_ATTESTATION",
        "SCHEMA_VALIDATION",
        "TEST_SUITE_RESULT",
        "BUILD_VERIFICATION"
      ],
      "description": "Must be an empirical verification artifact—never a skill or unexecuted plan."
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snap-[a-zA-Z0-9_-]+$"
    },
    "tree_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Explicit repository paths or logical components covered by this evidence."
    },
    "execution_id": {
      "type": "string",
      "pattern": "^exec-[a-zA-Z0-9_-]+$"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^obs-[a-zA-Z0-9_-]+$"
    },
    "predicate_satisfied": {
      "type": "boolean",
      "description": "Whether the verification predicate evaluated to true on the referenced observation."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
