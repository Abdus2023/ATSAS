#!/usr/bin/env python3
"""
.agent/tools/aif-red-suite — Canonical AIF-0.1.0 Kernel & RED Suite Wrapper.

Upgraded in Phase 13 to eliminate two-generation test runner drift:
  - Verifies that both `.claude/skills/_shared/aif/VERSION` and
    `.agent/skills/_shared/aif/VERSION` equal `"0.1.0"`.
  - Delegates execution to the single canonical AIF-0.1.0 kernel & behavioral
    verification suite at `tests/aif-v01-red-suite.py` (13 modular schemas,
    63 executable invariant tests covering AIF-001..AIF-055 + 8 sub-invariants,
    49 behavioral cases in cases.yaml [41 RED + 8 PRESSURE], and 15 producer
    adapter tests).
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


AGENT_DIR = Path(__file__).resolve().parent.parent
REPO_ROOT = AGENT_DIR.parent
CANONICAL_SUITE = REPO_ROOT / "tests" / "aif-v01-red-suite.py"


def main() -> int:
    claude_ver = (REPO_ROOT / ".claude" / "skills" / "_shared" / "aif" / "VERSION").read_text(encoding="utf-8").strip()
    agent_ver = (AGENT_DIR / "skills" / "_shared" / "aif" / "VERSION").read_text(encoding="utf-8").strip()
    if claude_ver != "0.1.0" or agent_ver != "0.1.0":
        print(
            f"  [FAIL] Version drift detected: .claude VERSION={claude_ver!r}, .agent VERSION={agent_ver!r} (expected '0.1.0')",
            file=sys.stderr,
        )
        return 1

    proc = subprocess.run([sys.executable, str(CANONICAL_SUITE), *sys.argv[1:]], cwd=str(REPO_ROOT))
    return proc.returncode


if __name__ == "__main__":
    sys.exit(main())
