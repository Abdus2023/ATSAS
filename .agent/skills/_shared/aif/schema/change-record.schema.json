{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.ai/schemas/aif/v0.1/change-record.schema.json",
  "title": "AIF-0.1 ChangeRecord",
  "description": "Distinguishes state transition DIFF(S0,S1) from actor causality via explicit attribution and attribution_basis (AIF-003, AIF-003A).",
  "type": "object",
  "required": [
    "path",
    "change_type",
    "before_digest",
    "after_digest",
    "intake_state",
    "execution_state",
    "attribution",
    "attribution_basis",
    "generated",
    "generated_by"
  ],
  "additionalProperties": false,
  "properties": {
    "path": { "type": "string", "minLength": 1 },
    "change_type": {
      "enum": ["ADDED", "MODIFIED", "DELETED", "RENAMED", "UNCHANGED"]
    },
    "before_digest": { "type": "string", "minLength": 1 },
    "after_digest": { "type": "string", "minLength": 1 },
    "intake_state": {
      "enum": ["CLEAN", "DIRTY", "PARTIAL", "UNKNOWN", "ABSENT"]
    },
    "execution_state": {
      "enum": ["CLEAN", "DIRTY", "PARTIAL", "UNKNOWN", "ABSENT"]
    },
    "attribution": {
      "enum": [
        "PREEXISTING",
        "AGENT_ATTRIBUTED",
        "EXTERNAL_ATTRIBUTED",
        "GENERATED",
        "UNATTRIBUTED",
        "UNKNOWN"
      ]
    },
    "attribution_basis": { "type": "string", "minLength": 1 },
    "generated": { "type": "boolean" },
    "generated_by": { "type": ["string", "null"] }
  }
}
