{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.ai/schemas/aif/v0.1/evidence-coverage.schema.json",
  "title": "AIF-0.1 EvidenceCoverage",
  "description": "Mathematical bridge Coverage(E, C) evaluating subject, snapshot, scope, method, freshness, and adequacy (AIF-007, AIF-014, AIF-014A, AIF-015, AIF-017).",
  "type": "object",
  "required": [
    "evidence_id",
    "claim_id",
    "subject_match",
    "snapshot_match",
    "scope_match",
    "method_match",
    "freshness",
    "adequacy",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "claim_id": { "type": "string", "minLength": 1 },
    "subject_match": { "type": "boolean" },
    "snapshot_match": { "type": "boolean" },
    "scope_match": { "type": "boolean" },
    "method_match": { "type": "boolean" },
    "freshness": {
      "enum": [
        "FRESH",
        "STALE",
        "SNAPSHOT_INDEPENDENT",
        "NON_INTERSECTING_CHANGE",
        "UNKNOWN"
      ]
    },
    "adequacy": {
      "enum": [
        "SUFFICIENT",
        "PARTIAL",
        "IRRELEVANT",
        "CONTRADICTORY",
        "UNKNOWN"
      ]
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
